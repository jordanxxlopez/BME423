 "s22-medicine-distance": {
  "steps": {
   "0": {"general": ["|q_i-r_i|,\\quad i=1,\\dots,m"],
         "work": ["|q_1-r_1|=|1-5|=4", "|q_2-r_2|=|1-4|=3"]},
   "1": {"general": ["d(q,r)=\\sqrt{\\sum_{i=1}^{m}(q_i-r_i)^2}=\\lVert q-r\\rVert_2"],
         "work": ["\\lVert q-r\\rVert_2=\\sqrt{4^2+3^2}=\\sqrt{25}=5"]},
   "2": {"general": ["d(q,r)=\\sum_{i=1}^{m}|q_i-r_i|=\\lVert q-r\\rVert_1"],
         "work": ["\\lVert q-r\\rVert_1=4+3=7"]},
   "3": {"general": ["d(q,r)=\\left(\\sum_{i=1}^{m}|q_i-r_i|^p\\right)^{1/p}=\\lVert q-r\\rVert_p"],
         "work": ["\\lVert q-r\\rVert_3=(4^3+3^3)^{1/3}=91^{1/3}=4.49794"]},
   "4": {"general": ["\\lVert q-r\\rVert_1\\ge\\lVert q-r\\rVert_2\\ge\\lVert q-r\\rVert_3"],
         "work": ["7\\ge 5\\ge 4.49794"]}
  }
 },
